# Leave offline for the reproducible synthetic demo; this makes no model calls.
DQ_PROVIDER=offline

# Set DQ_PROVIDER=nebius OR fireworks after filling the matching credentials.
# Choose a model available in your account that supports tool calling.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
FIREWORKS_API_KEY=
FIREWORKS_MODEL=

# Optional, explicit sanitized traces only. Keep disabled for the first run.
DQ_LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=data-quality-agent
# Automatic global tracing is disabled by the app to keep local data out of traces.
LANGSMITH_TRACING=false
